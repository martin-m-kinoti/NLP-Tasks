   "source": [
    "import nltk\n",
    "from nltk import word_tokenize, pos_tag, ne_chunk\n",
    "import string"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "ce2567f5",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "[Tree('GPE', [('Karanja', 'NNP')]),\n",
       " ('lives', 'VBZ'),\n",
       " ('in', 'IN'),\n",
       " Tree('GPE', [('Nairobi', 'NNP')]),\n",
       " ('and', 'CC'),\n",
       " ('works', 'VBZ'),\n",
       " ('at', 'IN'),\n",
       " Tree('ORGANIZATION', [('Safaricom', 'NNP')]),\n",
       " ('.', '.')]"
      ]
     },
     "execution_count": 4,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# NER\n",
    "sentence = \"Karanja lives in Nairobi and works at Safaricom.\"\n",
    "tokens = word_tokenize(sentence)\n",
    "tags = pos_tag(tokens)\n",
    "entities = ne_chunk(tags)\n",
    "[entity for entity in entities]"
   ]
  },
